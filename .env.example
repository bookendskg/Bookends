# --- Supabase ---
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Public anon key (used server-side only, for verifying admin login)
SUPABASE_ANON_KEY=

# Service-role key (SECRET — full DB access; never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# --- Session ---
# Long random string used to sign the admin session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Access control ---
# Comma-separated emails allowed into the admin dashboard (/admin) and admin API.
# Any other logged-in Supabase user can use the /automations portal but cannot
# manage content. If left blank, ANY logged-in user can reach /admin.
ADMIN_EMAILS=

# --- Runtime ---
# Set to "production" on Render (enables secure cookies behind the proxy).
NODE_ENV=development

# Local port (Render sets PORT automatically).
PORT=3000
